# Absolute path to the repo root. Required when the process working directory
# differs from the repo root (e.g. Windows Scheduled Tasks that start in
# C:\Windows\System32).
# Example: APP_DIR=C:\Users\willi\obsidian-rag-system
APP_DIR=

# Override the data folder (DB + secrets). Defaults to APP_DIR/data or
# process.cwd()/data. Set this if you want the DB in a custom location.
DATA_DIR=

# Self-hosting auth settings.
AUTH_SESSION_SECRET=change-me-for-production
ALLOW_SELF_SIGNUP=true
OWNER_EMAIL=discordboteternal@gmail.com
HOSTED_AI_ENABLED=true
PERSONAL_API_KEY_SECRET=change-me-too

# Email verification.
# Preferred provider: Resend. In local development, you can leave these blank
# and use EMAIL_VERIFICATION_DEV_MODE=true to reveal the code in the auth UI.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_VERIFICATION_DEV_MODE=true
EMAIL_VERIFICATION_REQUIRED=false

# Trust reverse-proxy IP headers (x-forwarded-for / x-real-ip) for rate limiting.
# Set true only when the app is behind a proxy you control that overwrites these headers.
TRUST_PROXY=false

# Optional local development fallback.
# Prefer user-entered keys in Settings for BYOK usage.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

# Optional hosted/shared-key configuration.
# If set, users on hosted AI plans can consume quota against this key.
HOSTED_OPENAI_API_KEY=
HOSTED_OPENAI_PROJECT_ID=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: run a local Ollama instance instead of OpenAI.
# Install Ollama (ollama.com), then run:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
#   ollama pull moondream
# Takes priority over hosted AI; user-entered API keys still take priority over Ollama.
OLLAMA_BASE_URL=
