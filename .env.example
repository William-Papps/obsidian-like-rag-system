# Absolute path to the repo root. Required when the process working directory
# differs from the repo root (e.g. Windows Scheduled Tasks that start in
# C:\Windows\System32).
# Example: APP_DIR=C:\Users\willi\obsidian-rag-system
APP_DIR=

# Override the data folder (DB + secrets). Defaults to APP_DIR/data or
# process.cwd()/data. Set this if you want the DB in a custom location.
DATA_DIR=

# Auth settings.
# REQUIRED — generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
ALLOW_SELF_SIGNUP=true
OWNER_EMAIL=owner@example.com
# REQUIRED — generate with: openssl rand -hex 32
PERSONAL_API_KEY_SECRET=

# Email verification.
# Preferred provider: Resend. In local development, leave these blank and set
# EMAIL_VERIFICATION_DEV_MODE=true to show the code in the auth UI.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_VERIFICATION_DEV_MODE=true
EMAIL_VERIFICATION_REQUIRED=false

# Trust reverse-proxy IP headers (x-forwarded-for / x-real-ip) for rate limiting.
# Set true only when the app is behind a proxy you control.
TRUST_PROXY=false

# Ollama — required for AI features.
# Install Ollama (ollama.com), then run:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2:3b
#   ollama pull moondream
OLLAMA_BASE_URL=http://localhost:11434
