# ── DEMO MODE ────────────────────────────────────────────────────────────────
# These are intentionally weak example secrets for local demo use only.
# The app will display a warning banner while DEMO_MODE=true.
# Before using for real notes, replace the two SECRET values below with
# long random strings and set DEMO_MODE=false (or remove it).
#
# Generate secrets:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

DEMO_MODE=true
AUTH_SESSION_SECRET=demo-only-not-for-production-replace-before-real-use
PERSONAL_API_KEY_SECRET=demo-only-not-for-production-replace-before-real-use

ALLOW_SELF_SIGNUP=true
OWNER_EMAIL=
HOSTED_AI_ENABLED=false

EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_DEV_MODE=false
RESEND_API_KEY=
EMAIL_FROM=

TRUST_PROXY=false

# Ollama is provided by the docker-compose sidecar — do not change this.
OLLAMA_BASE_URL=http://ollama:11434
